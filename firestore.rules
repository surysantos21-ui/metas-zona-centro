rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos autorizados a ver y editar el tablero.
    // Para dar acceso a otra persona: créale el usuario en Firebase
    // (Authentication > Users > Add user) Y agrega su correo aquí, en minúsculas.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'surysantos21@gmail.com'
        ];
    }

    match /metasZonaCentro/{docId} {
      allow read, write: if autorizado();
    }

    // Todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
